# ─────────────────────────────────────────────────────────────────────────────
# LUMINA-DS Environment Variables — copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Milvus ────────────────────────────────────────────────────────────────────
# Option A: Milvus Lite (zero-config, stores a local .db file — DEFAULT)
LUMINA_MILVUS_URI=./milvus_lumina.db

# Option B: Standalone Milvus server (Docker / cloud)
# LUMINA_MILVUS_URI=http://localhost:19530

# ── Ollama (local GPU-accelerated LLM — FREE, no API key needed) ─────────────
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

# GPU layers to offload:
#   -1 = ALL layers on GPU (full GPU mode — recommended if VRAM allows)
#    0 = CPU only
#   35 = partial offload (e.g. for 4 GB VRAM GPUs)
OLLAMA_NUM_GPU=-1

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Default values — override on the command line with --limit / --offset
INGEST_LIMIT=5000
INGEST_OFFSET=0
BATCH_SIZE=100

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
